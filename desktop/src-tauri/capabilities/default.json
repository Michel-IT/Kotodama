{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permessi per le finestre locali dell'app (main + toast). Le viste provider sono remote: l'IPC e' bloccato di default (solo kotodama_push/provider_login_probe sono concessi a loro, vedi provider-push.json). NOTA: build.rs dichiara ogni comando dell'app per generargli un permesso scoped -- questo mette l'intera app in modalita' ACL rigorosa, quindi OGNI comando deve comparire qui sotto o fallisce con 'not allowed... Command not found' (successo gia' una volta con show_provider_tab). Se si aggiunge un nuovo comando: aggiungerlo sia a build.rs sia a questa lista.",
  "windows": ["main", "toast"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir",
    "notification:default",
    "updater:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "allow-show-provider-tab",
    "allow-kotodama-broadcast",
    "allow-kotodama-push",
    "allow-provider-login-probe",
    "allow-mark-provider-known",
    "allow-kotodama-cancel",
    "allow-get-kotodama-sessions",
    "allow-save-kotodama-sessions",
    "allow-inline-toast",
    "allow-inline-finish",
    "allow-inline-fail",
    "allow-close-provider-view",
    "allow-set-provider-top-extra",
    "allow-provider-reload",
    "allow-provider-back",
    "allow-set-provider-menu-labels",
    "allow-provider-suppress",
    "allow-provider-dock",
    "allow-open-download-path",
    "allow-reveal-download-path",
    "allow-accept-clipboard",
    "allow-hide-toast",
    "allow-app-write-clipboard",
    "allow-show-main",
    "allow-hide-main",
    "allow-get-settings",
    "allow-get-system-locale",
    "allow-open-url",
    "allow-set-settings",
    "allow-save-ui-state",
    "allow-set-tray-labels",
    "allow-get-recipes",
    "allow-save-recipes",
    "allow-get-fields",
    "allow-save-fields",
    "allow-check-for-update",
    "allow-install-update",
    "allow-quit-app",
    "allow-restart-app"
  ]
}
