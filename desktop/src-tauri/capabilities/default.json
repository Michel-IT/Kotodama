{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the app's local windows (main + toast). Provider views are remote: IPC is blocked by default (only kotodama_push/provider_login_probe are granted to them, see provider-push.json). NOTE: build.rs declares every app command to generate a scoped permission for it -- this puts the whole app in strict ACL mode, so EVERY command must be listed below or it fails with 'not allowed... Command not found' (it happened once with show_provider_tab). When adding a new command: add it to both build.rs and this list.",
  "windows": ["main", "toast"],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "opener:allow-reveal-item-in-dir",
    "notification:default",
    "updater:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "allow-show-provider-tab",
    "allow-provider-icon",
    "allow-kotodama-broadcast",
    "allow-kotodama-set-attachments",
    "allow-kotodama-reuse-attachments",
    "allow-kotodama-file-info",
    "allow-kotodama-read-aloud",
    "allow-kotodama-regenerate",
    "allow-kotodama-audio-load",
    "allow-kotodama-audio-export",
    "allow-kotodama-audio-delete",
    "allow-kotodama-prewarm",
    "allow-kotodama-push",
    "allow-provider-login-probe",
    "allow-mark-provider-known",
    "allow-kotodama-cancel",
    "allow-kotodama-qwen-decision",
    "allow-terms-get",
    "allow-terms-accept",
    "allow-terms-decline",
    "allow-terms-withdraw",
    "allow-terms-set-provider",
    "allow-terms-set-providers",
    "allow-terms-consent-json",
    "allow-terms-export-file",
    "allow-get-kotodama-sessions",
    "allow-save-kotodama-sessions",
    "allow-inline-toast",
    "allow-inline-finish",
    "allow-inline-fail",
    "allow-close-provider-view",
    "allow-set-provider-top-extra",
    "allow-provider-reload",
    "allow-provider-back",
    "allow-set-provider-menu-labels",
    "allow-provider-suppress",
    "allow-provider-dock",
    "allow-open-download-path",
    "allow-reveal-download-path",
    "allow-accept-clipboard",
    "allow-hide-toast",
    "allow-paste-pending-origin",
    "allow-copy-pending",
    "allow-toast-fit",
    "allow-app-write-clipboard",
    "allow-show-main",
    "allow-hide-main",
    "allow-get-settings",
    "allow-get-system-locale",
    "allow-open-url",
    "allow-set-settings",
    "allow-save-ui-state",
    "allow-set-tray-labels",
    "allow-get-recipes",
    "allow-save-recipes",
    "allow-get-recipe-constraints",
    "allow-save-recipe-constraints",
    "allow-set-last-answer",
    "allow-check-for-update",
    "allow-install-update",
    "allow-quit-app",
    "allow-admin-start-state",
    "allow-set-admin-start",
    "allow-restart-as-admin",
    "allow-restart-app"
  ]
}
